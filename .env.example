# Local defaults require no credentials for deterministic evidence checks.
CB_DATA_DIR=.claimbreaker
CB_DATABASE_URL=sqlite:///.claimbreaker/claimbreaker.db
CB_SESSION_SECRET=
CB_SECURE_COOKIES=false
CB_OFFLINE=false
CB_PROVIDER=auto
CB_OPENAI_MODEL=gpt-6-luna
CB_OPENAI_REASONING=low
OPENAI_API_KEY=
CB_OLLAMA_URL=http://127.0.0.1:11434
CB_OLLAMA_MODEL=qwen3:8b
CB_RUNNER=auto
E2B_API_KEY=
CB_E2B_TEMPLATE=claimbreaker-cpu-v1
CB_DOCKER_IMAGE=claimbreaker-runner:0.1.0
# Optional: containerized offline app → private host Docker broker.
CB_RUNNER_URL=
CB_RUNNER_TOKEN=
GITHUB_TOKEN=
# Hosted profile: use private storage and a PostgreSQL connection string.
CB_SUPABASE_URL=
CB_SUPABASE_SERVICE_KEY=
CB_STORAGE_BUCKET=claimbreaker
# CB_DATABASE_URL=postgresql+psycopg://...
